{
  "name": "viernes-assistant",
  "productName": "Viernes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:electron": "electron .",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --outfile=dist-server/server.cjs --external:express --external:vite --external:@google/genai --external:dotenv --external:mathjs --external:undici",
    "dist:win": "python3 scripts/generate_icon.py && vite build && npm run build:server && electron-builder --win",
    "test:answers": "tsx scripts/test-answers.ts",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server dist-electron server.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.stark.viernes",
    "productName": "Viernes",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Viernes (FRIDAY)",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/sql.js/**/*",
      "**/*.wasm",
      "**/*.bin",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "*.ico",
          "*.png"
        ]
      }
    ]
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mathjs": "^15.2.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.14.2",
    "undici": "^7.3.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
